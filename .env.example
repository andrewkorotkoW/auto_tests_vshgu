# Пример .env для проекта. Скопируйте в .env и заполните реальными значениями.
# Реальный .env в git не попадает (см. .gitignore) — не коммитьте его и не публикуйте значения.

# ==================== Общие ====================
# Выбор окружения по умолчанию для pytest --env (develop|stage|prod), можно переопределить флагом --env
ENV=

DEFAULT_LOGIN=
DEFAULT_PASSWORD=
DEFAULT_REGION_ID=
DEFAULT_MUNICIPALITY_ID=
REQUEST_TIMEOUT=
UI_TIMEOUT=

# Учётка обычного пользователя, под которым логинятся некоторые UI-тесты
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Хост OpenLRS (ui/pages/lrs_admin_page.py: lrs_base_url) — опциональный override. Без него
# хост вычисляется из <ENV>_UI_URL заменой portal- -> lrs- (portal. -> lrs.).
LRS_URL=

# ---- Старые (плоские) имена — поддерживаются как fallback для develop/stage,
# ---- если соответствующая DEVELOP_/STAGE_ переменная ниже не задана. Новые
# ---- переменные настраивать через DEVELOP_*/STAGE_*/PROD_* ниже.
BASE_URL=
UI_BASE_URL=
GLOBAL_BASE_URL=
CAS_AUTH_TOKEN=
EXTERNAL_SYSTEM_CLIENT_TOKEN=
LPD_JWT_TOKEN=
STAGE_BASE_URL=
STAGE_DEVELOP_COOKIE=
STAGE_UI_BASE_URL=

# ==================== DEVELOP ====================
DEVELOP_API_URL=
DEVELOP_UI_URL=
DEVELOP_GLOBAL_URL=
# Кука сессии портала (develop) — используется только как запасной вариант,
# если логин по DEVELOP_LOGIN/DEVELOP_PASSWORD не сработал.
DEVELOP_COOKIE=
DEVELOP_COOKIE_NAME=
DEVELOP_CAS_TOKEN=
DEVELOP_EXTERNAL_TOKEN=
DEVELOP_LPD_JWT=
DEVELOP_BUK_TOKEN=

# Логин/пароль для автоматической авторизации (config/environments.py: login())
DEVELOP_LOGIN=
DEVELOP_PASSWORD=
# Отдельные роли, если в тестах нужны одновременно админ и слушатель
DEVELOP_ADMIN_LOGIN=
DEVELOP_ADMIN_PASSWORD=
DEVELOP_USER_LOGIN=
DEVELOP_USER_PASSWORD=

# ==================== STAGE ====================
STAGE_API_URL=
STAGE_UI_URL=
STAGE_GLOBAL_URL=
# Кука сессии портала (stage) — запасной вариант, если логин не сработал.
STAGE_COOKIE=
STAGE_COOKIE_NAME=
STAGE_CAS_TOKEN=
STAGE_EXTERNAL_TOKEN=
STAGE_LPD_JWT=
STAGE_BUK_TOKEN=

STAGE_LOGIN=
STAGE_PASSWORD=
STAGE_ADMIN_LOGIN=
STAGE_ADMIN_PASSWORD=
STAGE_USER_LOGIN=
STAGE_USER_PASSWORD=

# ==================== PROD ====================
# prod по умолчанию выключен: pytest --env=prod разрешает запускать только
# тесты с маркером smoke (см. config/environments.py: ensure_prod_allowed).
PROD_API_URL=
PROD_UI_URL=
PROD_GLOBAL_URL=
PROD_COOKIE=
PROD_COOKIE_NAME=
PROD_CAS_TOKEN=
PROD_EXTERNAL_TOKEN=
PROD_LPD_JWT=
PROD_BUK_TOKEN=

PROD_LOGIN=
PROD_PASSWORD=
PROD_ADMIN_LOGIN=
PROD_ADMIN_PASSWORD=
PROD_USER_LOGIN=
PROD_USER_PASSWORD=

# Test IT (tools/test_cases/testit_sync.py): адрес инстанса, PrivateToken и id проекта. Без них скрипт работает в сухом режиме.
TESTIT_URL=
TESTIT_TOKEN=
TESTIT_PROJECT_ID=

# ==================== Плагин test_hub (utils/test_hub_plugin.py) ====================
# Эти переменные передаёт раннер test_hub перед запуском pytest — руками их заполнять не
# нужно. Плагин активен только когда заданы все три: TH_URL, TH_RUN_ID, TH_RUN_TOKEN; без них
# не делает вообще ничего (ни print, ни сетевых вызовов). См. README, раздел 16.
TH_URL=
TH_RUN_ID=
TH_RUN_TOKEN=
# Живая трансляция (screencast) шагов теста — выключена, пока не задано TH_LIVE=1 (работает
# только вместе с TH_URL/TH_RUN_ID/TH_RUN_TOKEN выше).
TH_LIVE=
# Частота отправки кадров трансляции, кадров/сек. По умолчанию (если не задано) — 3.
TH_LIVE_FPS=
# TH_VIDEO=1 включает запись видео теста локально (workspace/video/local/) даже без
# TH_URL/TH_RUN_ID/TH_RUN_TOKEN — удобно для отладки, видео на test_hub при этом не отправляется.
TH_VIDEO=

# ==================== Готовность функциональности к автотестам ====================
# Флаги вида <FEATURE>_READY: каркас автотестов для ещё не реализованной функциональности
# лежит в репозитории заранее (клиент API, page objects, тесты), но должен быть пропущен
# (pytest.skip), пока контракт не подтверждён на ветке. Включать вручную (1/true/yes),
# когда функциональность появится. См. config/environments.py: is_feature_ready().
# Взаимопроверка ПЗ (p2p) — docs/missions/2026-09-30_tz2026_p2p.md, tests/api/p2p, tests/ui/p2p.
P2P_READY=
# Интеграция МТС Линк — docs/missions/2026-09-30_tz2026_mts_link.md, tests/api/mts_link, tests/ui/mts_link.
MTS_LINK_READY=
# Тенант стенда, на котором включена и проверена интеграция с МТС Линк (id организации
# из /admin/organization/{id} — см. docs/plans/2026-09-30_tz2026_mts_link_test_plan.md, п.4).
MTS_LINK_TENANT_ID=
# Переключатель мок/реальный клиент МТС Линк на стороне бэкенда теста — имя переменной и
# формат значения не подтверждены (план, п.4, вопрос 1), задел на будущее.
MTS_LINK_MOCK_MODE=
# DSN тестовой БД стенда для SQL-фоллбэка к request_log_audit, если отдельного API не
# появится (план, п.4, вопрос 4) — см. api/endpoints/mts_link.py: get_request_log_entries_via_sql.
MTS_LINK_DB_DSN=
